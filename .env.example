# PostHog analytics — same PostHog project key as the CRM app (app.paintstride.com).
# Must be set in this site's Vercel project env vars; unset = analytics no-op (local dev).
VITE_POSTHOG_KEY=
# Optional, defaults to https://us.i.posthog.com
VITE_POSTHOG_HOST=

# Meta (Facebook) Pixel — MUST be the SAME pixel ID as the CRM app
# (app.paintstride.com), so PageView/InitiateCheckout here stitch with the
# StartTrial/Purchase events fired there. Public, client-side value (it ships in
# the browser bundle). Set in this site's Vercel project env vars (Production +
# Preview); unset = pixel no-op (local dev).
VITE_META_PIXEL_ID=
